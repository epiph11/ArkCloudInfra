# Copy this file to terraform.tfvars and fill in the values below.
# terraform.tfvars is gitignored (see .gitignore) — never commit it once it contains real values.
#
# postgres_admin_password / aws_postgres_admin_password are deliberately NOT here, even as
# placeholders — set them via environment variables instead, so they never touch a file at all:
#
#   $env:TF_VAR_postgres_admin_password = "<a strong random value>"       (PowerShell, this session only, Azure)
#   $env:TF_VAR_aws_postgres_admin_password = "<a different strong random value>"   (AWS — separate credential, rotates independently)
#
# In CI, set them as pipeline secrets exposed the same way.

location    = "westeurope"
environment = "dev"

image_org     = "REPLACE_WITH_YOUR_GITHUB_ORG_OR_USERNAME"
api_image_tag = "latest"
web_image_tag = "latest"

postgres_sku     = "B_Standard_B1ms"
app_service_sku  = "B1"

aws_postgres_instance_class = "db.t3.micro"

# Optional (task #37) — subscribes this address to CloudWatch alarm notifications. Leave
# commented out to skip email delivery entirely; alarms still fire and are visible in the
# console/CLI either way.
# aws_alarm_email = "you@example.com"

# Optional (modules/azure/cost-guard) — 80% warning email + 100% action-triggered notification
# for the Azure budget. Leave commented out to skip the 80% warning; the automatic PostgreSQL
# stop at 100% still fires either way. azure_budget_amount_eur/azure_budget_start_date have
# working defaults (7 EUR/month, first of the month you first apply this) — override only if
# you want a different threshold or missed the first-of-month window.
# azure_alarm_email      = "you@example.com"
# azure_budget_amount_eur = 7
# azure_budget_start_date = "2026-08-01T00:00:00Z"

# "owner" tag is set in locals.tf now, not here — see that file's comment for why
# (terraform.tfvars is gitignored, so the CI apply job never saw it, and kept resetting the tag
# on every push). tags is still available for any other one-off extra tag you want merged on top.
tags = {}
